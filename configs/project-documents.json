{
  "server": "http://localhost:8080",
  "chunk_size": 262144,
  "replication": 2,
  "retention": 5,
  "jobs": [
    {
      "name": "project-documents",
      "paths": [
        "C:/path/to/project-documents"
      ],
      "exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/bin/**",
        "**/obj/**",
        "**/*.tmp",
        "**/*.log"
      ]
    }
  ]
}
