{
  "server": "http://localhost:8080",
  "chunk_size": 262144,
  "replication": 3,
  "retention": 5,
  "auth_token": "",
  "ca_cert_file": "",
  "insecure_skip_verify": false,
  "jobs": [
    {
      "name": "documents",
      "paths": [
        "C:/path/to/documents"
      ],
      "exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/bin/**",
        "**/obj/**",
        "**/*.tmp",
        "**/*.log"
      ]
    }
  ]
}
